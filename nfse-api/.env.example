# ─── Server ───────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── Autenticação do proxy ────────────────────────
MTLS_PROXY_TOKEN=gere-um-token-seguro-aqui

# ─── Certificado Digital A1 ──────────────────────
# Base64 do arquivo .pfx
CERT_PFX_BASE64=
# Senha do certificado
CERT_PASSWORD=

# ─── SEFAZ ────────────────────────────────────────
# Ambiente: 1 = Produção, 2 = Homologação
SEFAZ_AMBIENTE=2
# UF padrão do emitente (código IBGE, ex: 35 = SP)
SEFAZ_UF_CODIGO=35
